# Copy to `.env` and edit. `.env` is gitignored; this template is not.
# All variables below are read at startup; see docs/DEPLOYMENT.md. The file
# is consumed by docker-compose variable substitution, not loaded by the binary.

# REQUIRED. No default: the app exits at startup if this is unset or empty.
# Single root for everything mutable: $MEDIOSS_DATA_DIR/medioss.db and
# $MEDIOSS_DATA_DIR/media/. In Docker this is the mount point, so leave it as
# /data there; locally, `make run` points it at ./.data for you.
MEDIOSS_DATA_DIR=/data

# Optional. HTTP listen port. Defaults to 3000. Must parse as a port number.
PORT=3000

# Optional. Directory the built Astro bundle is served from.
# Defaults to the in-tree src/apps/web-api/static. The Docker runtime image
# overrides it to the path the assets were copied to.
MEDIOSS_STATIC_DIR=src/apps/web-api/static

# Optional. Standard `tracing`/`env_logger` filter, e.g. info, debug,
# or web_api=debug,tower_http=debug.
RUST_LOG=info

# REQUIRED. Used only as the possession proof for first-run setup. It does not
# sign opaque session cookies. Generate a strong value and never commit it:
#   openssl rand -base64 32
SESSION_SECRET=replace-me-with-openssl-rand-base64-32

# REQUIRED. The single public origin used for strict request-origin comparison.
# Include the scheme and optional non-default port, but no path or wildcard.
MEDIOSS_ORIGIN=http://localhost:3000

# Optional. Session lifetime in positive whole days, hours, minutes, or seconds.
# Defaults to 7d.
SESSION_TIMEOUT=7d

# Optional. Defaults to true. Set false only for deliberate local HTTP/LAN use;
# startup logs a warning because browsers may send the cookie without TLS.
SESSION_COOKIE_SECURE=true
