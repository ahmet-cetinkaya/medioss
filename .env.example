# MediOSS configuration — copy to .env and adjust for your setup.
# Every value here can also be set as a real environment variable; real
# environment variables take priority over this file.

# --- Required -------------------------------------------------------------

# Directory holding all runtime state (SQLite DB + media files).
# Created if missing. No default — the app refuses to start without it.
MEDIOSS_DATA_DIR=./data

# Strong random secret for host-possession checks (first-run setup).
# Generate a fresh one:  openssl rand -base64 32
SESSION_SECRET=

# The single origin the app is served from (scheme + host + optional port,
# no path). Browser-origin and redirect checks compare against it.
MEDIOSS_ORIGIN=http://localhost:3000

# --- Optional (defaults shown) --------------------------------------------

# Listen address (default 0.0.0.0, all interfaces; use 127.0.0.1 to keep it local).
# MEDIOSS_BIND=0.0.0.0

# Listen port.
PORT=3000

# Built-in UI assets directory. Default: src/apps/web-api/static
# (the Docker image overrides this to its bundled path).
#MEDIOSS_STATIC_DIR=

# Directory containing the built-in sound set (manifest.json + LICENSE).
# Probed in order: this variable, /srv/medioss/builtin-sounds, ./builtin-sounds
MEDIOSS_BUILTIN_SOUNDS_DIR=assets/sounds/soundscape-builtin

# Session lifetime: positive number + d/h/m/s unit. Default: 7d
#SESSION_TIMEOUT=7d

# Send session cookies only over HTTPS. Keep true in production;
# false is for deliberate local HTTP/LAN setups (emits a startup warning).
# For a plain-HTTP localhost trial, set it to false.
SESSION_COOKIE_SECURE=true

# Development only: one extra origin allowed for state-changing requests,
# e.g. the Astro dev server. scripts/dev.sh sets it; leave unset in production.
#MEDIOSS_DEV_ORIGIN=http://localhost:4321

# --- First-run setup ------------------------------------------------------
# After starting, open MEDIOSS_ORIGIN and register the initial admin via the
# setup page (requires the SESSION_SECRET above), or run scripts/setup.sh.
