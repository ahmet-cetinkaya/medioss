# Copy to `.env` and edit. `.env` is gitignored; this template is not.
# Only MEDIOSS_DATA_DIR is read at startup today. See docs/DEPLOYMENT.md.

# REQUIRED. No default: the app exits at startup if this is unset or empty.
# Single root for everything mutable: $MEDIOSS_DATA_DIR/medioss.db and
# $MEDIOSS_DATA_DIR/media/. In Docker this is the mount point, so leave it as
# /data there; locally, `make run` points it at ./.data for you.
MEDIOSS_DATA_DIR=/data

# Optional. HTTP listen port. Defaults to 3000. Must parse as a port number.
PORT=3000

# Optional. Directory the built Astro bundle is served from.
# Defaults to the in-tree src/apps/web-api/static. The Docker runtime image
# overrides it to the path the assets were copied to.
MEDIOSS_STATIC_DIR=src/apps/web-api/static

# Optional. Standard `tracing`/`env_logger` filter, e.g. info, debug,
# or web_api=debug,tower_http=debug.
RUST_LOG=info

# Reserved for M1 (authentication). The binary does not read this yet, so it has
# no effect on startup. docker-compose.yml still requires it to be non-empty, so
# set a real value before running `make up`:
#   openssl rand -base64 32
# Never commit the generated value. The placeholder below is not a secret.
JWT_SECRET=replace-me-with-openssl-rand-base64-32
