---
// Layout for Login and Setup (plan D1, FR-079). The island renders the
// whole page through UnauthenticatedLayout (canvas, brand, one centered
// panel, language switcher, its own <main>), so this layout adds no wrapper:
//
//   ---
//   import AuthLayout from "../layouts/AuthLayout.astro";
//   import AuthSkeleton from "../layouts/AuthSkeleton.astro";
//   import LoginPage from "$lib/screens/login/login-page.svelte";
//   import { screenTitleMessages } from "$lib/i18n/common.messages";
//   ---
//
//   <AuthLayout title={screenTitleMessages.login}>
//     <LoginPage client:only="svelte">
//       <AuthSkeleton slot="fallback" />
//     </LoginPage>
//   </AuthLayout>
//
// `title` is the screen title message (static English <title> before
// hydration; the island switches it to the active language). A plain string
// is accepted for the legacy pages until they are replaced.
import { shellMessages } from "$lib/components/shell/shell.messages";
import { brandMessages } from "$lib/i18n/common.messages";
import type { StringMessage } from "$lib/i18n/message";
import { translate } from "$lib/i18n/translate";
import Base from "./Base.astro";

interface Props {
  title: string | StringMessage;
  description?: string;
}

const { title, description } = Astro.props;
const documentTitle =
  typeof title === "string"
    ? title
    : translate(shellMessages.documentTitle, "en", {
        screen: translate(title, "en"),
        product: translate(brandMessages.productName, "en"),
      });
---

<Base title={documentTitle} description={description}>
  <slot />
</Base>
